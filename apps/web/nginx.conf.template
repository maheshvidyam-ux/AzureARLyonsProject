# SPA + reviewer API reverse proxy. Container Apps ingress targets port 8080.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Static assets + client-side routing: fall back to index.html for unknown paths.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Reviewer / upload / settings API → the internal API container. The trailing slash on
  # proxy_pass strips the matched `/api/` prefix (matches the dev Vite proxy rewrite), and the
  # Easy Auth identity headers injected at the public edge are forwarded to the API.
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-MS-CLIENT-PRINCIPAL $http_x_ms_client_principal;
    proxy_set_header X-MS-CLIENT-PRINCIPAL-ID $http_x_ms_client_principal_id;
    proxy_set_header X-MS-CLIENT-PRINCIPAL-NAME $http_x_ms_client_principal_name;
    proxy_set_header X-MS-CLIENT-PRINCIPAL-IDP $http_x_ms_client_principal_idp;
    # Uploaded documents can be a few MB.
    client_max_body_size 25m;
  }
}
