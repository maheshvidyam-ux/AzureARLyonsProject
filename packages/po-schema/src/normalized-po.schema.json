{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://customer-order-automation/schemas/normalized-po.json",
  "title": "NormalizedPurchaseOrder",
  "description": "Schema-constrained output of AI Foundry interpretation, normalized from Document Intelligence evidence (spec §5). Raw and normalized values are preserved separately. AI never invents missing IDs: unknown => null, with a validation finding.",
  "type": "object",
  "required": ["document_id", "schema_version", "company", "header", "lines", "extraction"],
  "additionalProperties": false,
  "properties": {
    "document_id": { "type": "string", "description": "FK to source_document" },
    "order_id": { "type": ["string", "null"], "description": "Internal order id once an order_header exists" },
    "schema_version": { "type": "string", "examples": ["1.0.0"] },
    "company": {
      "type": "object",
      "description": "Legal entity / dataAreaId — company-level partition, not a tenant.",
      "required": ["company_id"],
      "properties": {
        "company_id": { "type": "string" },
        "resolved_from": { "type": "string", "enum": ["email_domain", "document", "manual", "default"] }
      }
    },
    "header": { "$ref": "#/$defs/header" },
    "lines": { "type": "array", "items": { "$ref": "#/$defs/line" }, "minItems": 0 },
    "extraction": { "$ref": "#/$defs/extractionMeta" },
    "validation": {
      "type": "array",
      "description": "Deterministic validation findings; AI confidence never clears a blocking finding.",
      "items": { "$ref": "#/$defs/validationFinding" }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Traceability back to the source document for field highlighting (§9, §14).",
      "properties": {
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "bounding_boxes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "polygon": { "type": "array", "items": { "type": "number" }, "description": "x1,y1,...,xn,yn normalized 0..1" }
            }
          }
        },
        "raw_text": { "type": ["string", "null"], "description": "Original OCR text, kept separate from normalized value" },
        "text_anchors": { "type": "array", "items": { "type": "string" } },
        "provider_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "prediction_source": { "type": ["string", "null"], "enum": ["DI", "FOUNDRY", "LEARNED_RULE", "USER", null] },
        "prediction_version": { "type": ["string", "null"] }
      }
    },
    "field": {
      "description": "A value plus its evidence. 'raw' is the original string; 'value' is normalized.",
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {},
        "raw": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "header": {
      "type": "object",
      "description": "spec §5 header schema",
      "additionalProperties": false,
      "properties": {
        "customer": {
          "type": "object",
          "properties": {
            "erp_customer_account": { "$ref": "#/$defs/field", "description": "null until matched; never invented" },
            "name": { "$ref": "#/$defs/field" },
            "match_status": { "type": "string", "enum": ["EXACT", "CROSS_REF", "ALIAS", "ADDRESS", "HISTORY", "FUZZY", "UNMATCHED"] }
          }
        },
        "customer_po_number": { "$ref": "#/$defs/field" },
        "normalized_po_number": { "type": ["string", "null"], "description": "Canonicalized PO# used in the duplicate business key" },
        "po_date": { "$ref": "#/$defs/field" },
        "requested_delivery_date": { "$ref": "#/$defs/field" },
        "bill_to": { "$ref": "#/$defs/field" },
        "ship_to": { "$ref": "#/$defs/field" },
        "currency": { "$ref": "#/$defs/field" },
        "payment_terms": { "$ref": "#/$defs/field" },
        "shipping_terms": { "$ref": "#/$defs/field" },
        "totals": {
          "type": "object",
          "properties": {
            "subtotal": { "$ref": "#/$defs/money" },
            "tax": { "$ref": "#/$defs/money" },
            "grand_total": { "$ref": "#/$defs/money" }
          }
        },
        "special_instructions": { "$ref": "#/$defs/field" }
      }
    },
    "line": {
      "type": "object",
      "description": "spec §5 line schema",
      "required": ["line_id"],
      "additionalProperties": false,
      "properties": {
        "line_id": { "type": "string" },
        "source_line_no": { "type": ["integer", "null"] },
        "customer_item_code": { "$ref": "#/$defs/field" },
        "description": { "$ref": "#/$defs/field" },
        "erp_item_id": { "$ref": "#/$defs/field", "description": "null until matched; no description-only blind auto-match" },
        "quantity": { "$ref": "#/$defs/field" },
        "uom": { "$ref": "#/$defs/field" },
        "unit_price": { "$ref": "#/$defs/field" },
        "extended_amount": { "$ref": "#/$defs/field" },
        "requested_date": { "$ref": "#/$defs/field" },
        "match_status": { "type": "string", "enum": ["EXACT_SKU", "CUSTOMER_MAP", "GTIN", "PACK_UOM", "DESC_SIMILARITY", "UNMATCHED"] }
      }
    },
    "extractionMeta": {
      "type": "object",
      "required": ["overall_confidence"],
      "properties": {
        "di_model_version": { "type": ["string", "null"] },
        "foundry_deployment": { "type": ["string", "null"] },
        "foundry_prompt_version": { "type": ["string", "null"] },
        "overall_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "multi_order_segment": {
          "type": ["object", "null"],
          "description": "Set when one document contains multiple POs (§5).",
          "properties": {
            "segment_index": { "type": "integer" },
            "segment_total": { "type": "integer" },
            "ambiguous": { "type": "boolean" }
          }
        },
        "document_quality_flags": {
          "type": "array",
          "items": { "type": "string", "enum": ["SCANNED", "ROTATED", "LOW_QUALITY", "TABLE_SPANS_PAGES", "UNKNOWN_TEMPLATE", "MISSING_FIELDS"] }
        }
      }
    },
    "validationFinding": {
      "type": "object",
      "required": ["severity", "code", "blocking"],
      "properties": {
        "severity": { "type": "string", "enum": ["ERROR", "WARNING"] },
        "code": { "type": "string" },
        "field_path": { "type": ["string", "null"] },
        "message": { "type": "string" },
        "blocking": { "type": "boolean", "description": "true => cannot stage regardless of AI confidence" }
      }
    }
  }
}
