{
  "name": "azure-arap-lyons",
  "version": "0.1.0",
  "private": true,
  "description": "Azure-native AR order + AP invoice automation (Lyons) on one shared pipeline — M365 email → DI/Foundry → Fabric masters → reviewer → Boomi/AX. Two modules: ORDER_PROCESSING, AP_INVOICE.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:migrations": "node scripts/check-migrations.mjs",
    "demo:slice": "tsx apps/workers/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mssql": "^9.1.11",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@azure/ai-form-recognizer": "^5.1.0",
    "@azure/identity": "^4.14.1",
    "@azure/service-bus": "^7.10.0",
    "@azure/storage-blob": "^12.34.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8",
    "mssql": "^11.0.2",
    "openai": "^4.104.0"
  }
}
